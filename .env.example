# Copy this file to .env and add your own Groq API key.
# Never commit .env or paste your key into source code.
# A usable key in this project-root .env takes precedence over inherited Windows/user/system variables.
# After changing keys, stop Streamlit completely and restart it.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=all-MiniLM-L6-v2
