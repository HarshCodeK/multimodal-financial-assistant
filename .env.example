# --- Required ---------------------------------------------------------------
# Create .env from this file and paste your key. Never commit .env.
GROQ_API_KEY=your_key_here

# --- Optional overrides -----------------------------------------------------
# Default LLM. Must be one of the ids in src/models.py MODELS.
# qwen/qwen3.8-27b is the only vision-capable option on the current catalogue,
# so it is required for image uploads.
MFA_MODEL=qwen/qwen3.8-27b

# Embedding model for the ChromaDB vector store. Kept local so retrieval
# works offline and costs nothing.
MFA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the vector store and the interaction log live.
MFA_CHROMA=./chroma_db
MFA_DB=./logs.db
